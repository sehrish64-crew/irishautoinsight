# Production / Live env (copy to .env.production or set in hosting provider)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_TO=autofactschecks@gmail.com

# Production Database
DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=carvertical
DB_USER=your_database_user
DB_PASSWORD=your_database_password

NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://your-production-domain.com

# SMTP (Gmail) - use app password or a dedicated SMTP provider credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Production Environment Variables Template
# Copy this to .env.local on your Hostinger server and update values

# Base URL for your domain
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Node Environment
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=mysql.u319625572.hostinger.com
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=u319625572_trueautocheck
DB_PORT=3306

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# PayPal Configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your_paypal_secret

# Resend Email Service (Optional)
RESEND_API_KEY=your_resend_api_key

# Localization
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,es,fr,de,ar,ur
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Feature Flags
NEXT_PUBLIC_ENABLE_REVIEWS=true
